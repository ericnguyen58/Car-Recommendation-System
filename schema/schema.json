{
  "files": {
    "all_cars.csv": {
      "description": "Vehicle specifications and features per trim level",
      "columns": {
        "car_id": {
          "dtype": "string",
          "role": "primary_key",
          "nullable": false,
          "max_length": 10,
          "format": "{MAKE3}{YY}{MODEL3}{SEQ2}",
          "components": {
            "MAKE3":   "First 3 uppercase alphanumeric chars of brand (e.g. Ford→FOR, Mercedes-Benz→MER)",
            "YY":      "Last 2 digits of model year, zero-padded (e.g. 2001→01, 2022→22)",
            "MODEL≤3": "First 1-3 uppercase alphanumeric chars of model (e.g. F-150→F15, S5→S5, 911→911)",
            "SEQ2":    "2-digit counter (01-99) within each MAKE3+YY+MODEL group, preserving row order"
          },
          "examples": ["FOR01F1501", "MER21GLC03", "AUD22S501", "TOY23TAC03"],
          "description": "Compact unique vehicle identifier; 8-10 characters"
        },
        "make": {
          "dtype": "string",
          "role": "identifier",
          "nullable": false,
          "description": "Manufacturer brand name"
        },
        "model": {
          "dtype": "string",
          "role": "identifier",
          "nullable": false,
          "description": "Vehicle model name"
        },
        "year": {
          "dtype": "int",
          "role": "identifier",
          "nullable": false,
          "description": "Model year"
        },
        "bodytype": {
          "dtype": "category",
          "role": "feature",
          "nullable": true,
          "description": "Body style of the vehicle"
        },
        "trim": {
          "dtype": "string",
          "role": "identifier",
          "nullable": true,
          "description": "Specific trim / configuration name"
        },
        "price": {
          "dtype": "float",
          "role": "target_candidate",
          "unit": "USD",
          "nullable": true,
          "description": "Base MSRP price in US dollars"
        },
        "mpg_city": {
          "dtype": "float",
          "role": "feature",
          "unit": "mpg",
          "nullable": true,
          "description": "City fuel economy in miles per gallon"
        },
        "mpg_hwy": {
          "dtype": "float",
          "role": "feature",
          "unit": "mpg",
          "nullable": true,
          "description": "Highway fuel economy in miles per gallon"
        },
        "mpg_comb": {
          "dtype": "float",
          "role": "feature",
          "unit": "mpg",
          "nullable": true,
          "description": "Combined fuel economy in miles per gallon"
        },
        "Fuel Type": {
          "dtype": "category",
          "role": "feature",
          "nullable": true,
          "allowed_values": ["Gas", "Diesel", "Electric", "Hybrid", "Flexible Fuel", "Natural Gas"],
          "recode": {
            "ElectricLeafIcon": "Electric",
            "HybridLeafIcon": "Hybrid"
          },
          "description": "Primary fuel type; icon-encoded values are remapped to plain labels"
        },
        "hp": {
          "dtype": "float",
          "role": "feature",
          "unit": "horsepower",
          "nullable": true,
          "description": "Peak engine horsepower"
        },
        "Engine": {
          "dtype": "string",
          "role": "metadata",
          "nullable": true,
          "description": "Free-text engine description (e.g. 'V6, 4.2 Liter')"
        },
        "torque_lbft": {
          "dtype": "float",
          "role": "feature",
          "unit": "lb-ft",
          "nullable": true,
          "description": "Peak engine torque in pound-feet"
        },
        "cargo_cuft": {
          "dtype": "float",
          "role": "feature",
          "unit": "cubic_feet",
          "nullable": true,
          "description": "Cargo volume in cubic feet"
        },
        "0 - 60": {
          "dtype": "float",
          "role": "feature",
          "unit": "seconds",
          "nullable": true,
          "raw_unit": "seconds suffix string",
          "parse": "strip ' seconds', map 'N/A'/'Not Available'/'Not available' to NaN",
          "description": "0-60 mph acceleration time in seconds"
        },
        "curb_weight_lbs": {
          "dtype": "float",
          "role": "feature",
          "unit": "lbs",
          "nullable": true,
          "description": "Vehicle curb weight in pounds"
        },
        "Drivetrain": {
          "dtype": "category",
          "role": "feature",
          "nullable": true,
          "allowed_values": ["FWD", "RWD", "AWD", "4WD", "2WD"],
          "description": "Drivetrain configuration"
        },
        "Transmission Type": {
          "dtype": "category",
          "role": "feature",
          "nullable": true,
          "allowed_values": ["Automatic", "Manual"],
          "na_values": ["Not Available"],
          "description": "Transmission type; 'Not Available' mapped to NaN"
        },
        "Recommended Fuel": {
          "dtype": "category",
          "role": "feature",
          "nullable": true,
          "allowed_values": ["Regular", "Premium", "Diesel", "E85", "CNG"],
          "na_values": ["Not Available"],
          "description": "Recommended fuel grade; 'Not Available' mapped to NaN"
        },
        "Fuel Capacity": {
          "dtype": "float",
          "role": "feature",
          "unit": "gallons",
          "nullable": true,
