    "all_reviews.csv": {
      "description": "Consumer and expert ratings per make/model/year",
      "columns": {
        "make": {
          "dtype": "string",
          "role": "identifier",
          "nullable": false,
          "description": "Manufacturer brand name"
        },
        "model": {
          "dtype": "string",
          "role": "identifier",
          "nullable": false,
          "description": "Vehicle model name"
        },
        "year": {
          "dtype": "int",
          "role": "identifier",
          "nullable": false,
          "description": "Model year"
        },
        "consumer_overall_rating": {
          "dtype": "float",
          "role": "target_candidate",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Aggregate consumer rating (1–5 stars)"
        },
        "consumer_review_count": {
          "dtype": "int",
          "role": "feature",
          "nullable": true,
          "description": "Total number of consumer reviews submitted"
        },
        "consumer_recommend_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of reviewers who recommend the vehicle"
        },
        "star_5_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of 5-star ratings"
        },
        "star_4_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of 4-star ratings"
        },
        "star_3_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of 3-star ratings"
        },
        "star_2_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of 2-star ratings"
        },
        "star_1_pct": {
          "dtype": "float",
          "role": "feature",
          "unit": "percent",
          "range": [0.0, 100.0],
          "nullable": true,
          "description": "Percentage of 1-star ratings"
        },
        "rating_value": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: value for money"
        },
        "rating_performance": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: performance"
        },
        "rating_quality": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: build quality"
        },
        "rating_comfort": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: comfort"
        },
        "rating_reliability": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: reliability"
        },
        "rating_styling": {
          "dtype": "float",
          "role": "feature",
          "range": [1.0, 5.0],
          "nullable": true,
          "description": "Consumer sub-rating: styling"
        },
        "expert_rating": {
          "dtype": "float",
          "role": "target_candidate",
          "nullable": true,
          "description": "Editorial expert overall score"
        },
        "expert_ranking": {
          "dtype": "int",
          "role": "feature",
          "nullable": true,
          "raw_format": "string like '#N in <category> for <year>'",
          "parse": "extract leading integer N from the '#N' prefix",
          "description": "Expert category rank (lower is better); extracted from ranking string"
        },
        "pros": {
          "dtype": "string",
          "role": "metadata",
          "nullable": true,
          "description": "Expert-listed pros (currently unpopulated)"
        },
        "cons": {
          "dtype": "string",
          "role": "metadata",
          "nullable": true,
          "description": "Expert-listed cons (currently unpopulated)"
        }
      }
    }
